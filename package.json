{
  "name": "dsh-tool-comfyui",
  "version": "1.0.0",
  "description": "Let DeepSeek Harness generate images: call local or LAN ComfyUI workers directly from chat (status, generate, queue).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "workflows/**/*.json",
    "cordis.patch.yml",
    "start-comfyui-worker.bat",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "image-generation",
    "stable-diffusion",
    "sdxl"
  ],
  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-comfyui.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-comfyui#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-comfyui/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}